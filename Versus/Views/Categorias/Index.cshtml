@model IEnumerable<Versus.ViewModels.CategoriaViewModel>

@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categorías</h2>
    <a asp-action="Create" class="btn btn-primary">+ Agregar Categoría</a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Exito"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Rango de Peso (kg)</th>
                    <th>Rango de Edad</th>
                    <th>Competidores</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Nombre</strong></td>
                        <td>@item.Descripcion</td>
                        <td>@(item.PesoMinimo.HasValue || item.PesoMaximo.HasValue ? $"{item.PesoMinimo?.ToString("F1") ?? "—"} - {item.PesoMaximo?.ToString("F1") ?? "—"}" : "—")</td>
                        <td>@(item.EdadMinima.HasValue || item.EdadMaxima.HasValue ? $"{item.EdadMinima?.ToString() ?? "—"} - {item.EdadMaxima?.ToString() ?? "—"}" : "—")</td>
                        <td><span class="badge bg-info text-dark">@item.CantidadCompetidores</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay categorías. <a asp-action="Create">Agregar una</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
