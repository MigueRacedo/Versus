@{
    ViewData["Title"] = "Versus - Combat Sports Management";
}

<div class="text-center mb-5">
    <h1 class="display-4">Versus</h1>
    <p class="lead">Combat Sports Competition Management System</p>
</div>

<div class="row text-center g-4 mb-5">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="display-5 text-primary">@ViewBag.CompetitorCount</h2>
                <h5 class="card-title">Competitors</h5>
                <p class="text-muted">Registered athletes across all categories</p>
                <a asp-controller="Competitors" asp-action="Index" class="btn btn-outline-primary">Manage Competitors</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="display-5 text-success">@ViewBag.CategoryCount</h2>
                <h5 class="card-title">Categories</h5>
                <p class="text-muted">Weight and age divisions configured</p>
                <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-success">Manage Categories</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="display-5 text-warning">@ViewBag.CompetitionCount</h2>
                <h5 class="card-title">Competitions</h5>
                <p class="text-muted">Events with brackets and match results</p>
                <a asp-controller="Competitions" asp-action="Index" class="btn btn-outline-warning">Manage Competitions</a>
            </div>
        </div>
    </div>
</div>

