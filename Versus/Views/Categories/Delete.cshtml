@model Versus.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Category</h4>
            </div>
            <div class="card-body">
                <p class="lead">Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                <dl class="row">
                    <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@(Model.Description ?? "—")</dd>
                    <dt class="col-sm-4">Competitors</dt><dd class="col-sm-8">@Model.CompetitorCount</dd>
                </dl>
                @if (Model.CompetitorCount > 0)
                {
                    <div class="alert alert-warning">This category has @Model.CompetitorCount competitor(s). Deleting it will unassign them.</div>
                }
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
</div>
