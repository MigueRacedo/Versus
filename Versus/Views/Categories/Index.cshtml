@model IEnumerable<Versus.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Category</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Weight Range (kg)</th>
                    <th>Age Range</th>
                    <th>Competitors</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Description</td>
                        <td>@(item.MinWeight.HasValue || item.MaxWeight.HasValue ? $"{item.MinWeight?.ToString("F1") ?? "—"} - {item.MaxWeight?.ToString("F1") ?? "—"}" : "—")</td>
                        <td>@(item.MinAge.HasValue || item.MaxAge.HasValue ? $"{item.MinAge?.ToString() ?? "—"} - {item.MaxAge?.ToString() ?? "—"}" : "—")</td>
                        <td><span class="badge bg-info text-dark">@item.CompetitorCount</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No categories found. <a asp-action="Create">Add one</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
