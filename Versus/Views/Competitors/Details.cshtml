@model Versus.ViewModels.CompetitorViewModel

@{
    ViewData["Title"] = "Competitor Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">@Model.Name</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Age</dt>
                    <dd class="col-sm-8">@Model.Age years</dd>
                    <dt class="col-sm-4">Weight</dt>
                    <dd class="col-sm-8">@Model.Weight.ToString("F1") kg</dd>
                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">
                        @if (Model.CategoryName != null)
                        {
                            <span class="badge bg-primary fs-6">@Model.CategoryName</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Unassigned</span>
                        }
                    </dd>
                </dl>
                <hr />
                <h5>Assign / Change Category</h5>
                <form asp-action="AssignCategory" method="post">
                    <input type="hidden" name="competitorId" value="@Model.Id" />
                    <div class="input-group">
                        <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                            <option value="">-- Remove Category --</option>
                        </select>
                        <button type="submit" class="btn btn-primary">Assign</button>
                    </div>
                </form>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>
