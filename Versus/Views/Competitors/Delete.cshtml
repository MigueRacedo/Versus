@model Versus.ViewModels.CompetitorViewModel

@{
    ViewData["Title"] = "Delete Competitor";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Competitor</h4>
            </div>
            <div class="card-body">
                <p class="lead">Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                <dl class="row">
                    <dt class="col-sm-4">Age</dt><dd class="col-sm-8">@Model.Age</dd>
                    <dt class="col-sm-4">Weight</dt><dd class="col-sm-8">@Model.Weight kg</dd>
                    <dt class="col-sm-4">Category</dt><dd class="col-sm-8">@(Model.CategoryName ?? "None")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
</div>
