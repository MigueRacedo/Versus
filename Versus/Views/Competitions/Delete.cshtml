@model Versus.ViewModels.CompetitionViewModel

@{
    ViewData["Title"] = "Delete Competition";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Delete Competition</h4>
            </div>
            <div class="card-body">
                <p class="lead">Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                <dl class="row">
                    <dt class="col-sm-4">Date</dt><dd class="col-sm-8">@Model.Date.ToString("MMM dd, yyyy")</dd>
                    <dt class="col-sm-4">Location</dt><dd class="col-sm-8">@(Model.Location ?? "—")</dd>
                    <dt class="col-sm-4">Category</dt><dd class="col-sm-8">@(Model.CategoryName ?? "—")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
</div>
