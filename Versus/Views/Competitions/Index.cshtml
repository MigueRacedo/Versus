@model IEnumerable<Versus.ViewModels.CompetitionViewModel>

@{
    ViewData["Title"] = "Competitions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Competitions</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Competition</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Category</th>
                    <th>Bracket</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Date.ToString("MMM dd, yyyy")</td>
                        <td>@(item.Location ?? "—")</td>
                        <td>
                            @if (item.CategoryName != null)
                            {
                                <span class="badge bg-primary">@item.CategoryName</span>
                            }
                        </td>
                        <td>
                            @if (item.HasBracket)
                            {
                                <span class="badge bg-success">Generated</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">None</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No competitions found. <a asp-action="Create">Add one</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
