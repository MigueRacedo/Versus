@model Versus.ViewModels.CompetenciaViewModel

@{
    ViewData["Title"] = "Detalles de la Competencia";
    var llave = ViewBag.Llave as Versus.ViewModels.LlaveViewModel;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Nombre</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Exito"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Fecha</dt>
                    <dd class="col-sm-7">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-5">Lugar</dt>
                    <dd class="col-sm-7">@(Model.Lugar ?? "—")</dd>
                    <dt class="col-sm-5">Categoría</dt>
                    <dd class="col-sm-7">
                        @if (Model.NombreCategoria != null)
                        {
                            <span class="badge bg-primary">@Model.NombreCategoria</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Llave</h5>
                <form asp-action="GenerateBracket" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-success">
                        @(llave != null ? "Regenerar Llave" : "Generar Llave")
                    </button>
                </form>
            </div>
            <div class="card-body">
                @if (llave == null)
                {
                    <p class="text-muted mb-0">Aún no se ha generado la llave. Haga clic en "Generar Llave" para crearla con los competidores de la categoría.</p>
                }
                else
                {
                    foreach (var ronda in llave.Rondas)
                    {
                        <h6 class="fw-bold mt-2">@ronda.NombreRonda</h6>
                        <table class="table table-sm table-bordered mb-3">
                            <thead class="table-light">
                                <tr><th>#</th><th>Competidor 1</th><th>Competidor 2</th><th>Estado</th><th>Ganador</th><th>Acción</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var combate in ronda.Combates)
                                {
                                    <tr class="@(combate.Estado == "Completado" ? "table-success" : combate.Estado == "Libre" ? "table-secondary" : "")">
                                        <td>@combate.NumeroCombate</td>
                                        <td>@combate.NombreCompetidor1</td>
                                        <td>@combate.NombreCompetidor2</td>
                                        <td><span class="badge bg-@(combate.Estado == "Completado" ? "success" : combate.Estado == "Libre" ? "secondary" : "warning text-dark")">@combate.Estado</span></td>
                                        <td>@(combate.NombreGanador ?? "—")</td>
                                        <td>
                                            @if (combate.Estado == "Pendiente" && combate.Competidor1Id.HasValue && combate.Competidor2Id.HasValue)
                                            {
                                                <div class="d-flex gap-1">
                                                    <form asp-action="RecordResult" method="post" class="d-inline">
                                                        <input type="hidden" name="matchId" value="@combate.Id" />
                                                        <input type="hidden" name="winnerId" value="@combate.Competidor1Id" />
                                                        <input type="hidden" name="competitionId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-xs btn-outline-success" style="font-size:0.75rem;padding:1px 6px">@combate.NombreCompetidor1 gana</button>
                                                    </form>
                                                    <form asp-action="RecordResult" method="post" class="d-inline">
                                                        <input type="hidden" name="matchId" value="@combate.Id" />
                                                        <input type="hidden" name="winnerId" value="@combate.Competidor2Id" />
                                                        <input type="hidden" name="competitionId" value="@Model.Id" />
                                                        <button type="submit" class="btn btn-xs btn-outline-success" style="font-size:0.75rem;padding:1px 6px">@combate.NombreCompetidor2 gana</button>
                                                    </form>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>
    </div>
</div>
