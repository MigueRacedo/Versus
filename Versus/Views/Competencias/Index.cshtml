@model IEnumerable<Versus.ViewModels.CompetenciaViewModel>

@{
    ViewData["Title"] = "Competencias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Competencias</h2>
    <a asp-action="Create" class="btn btn-primary">+ Agregar Competencia</a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Exito"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Fecha</th>
                    <th>Lugar</th>
                    <th>Categoría</th>
                    <th>Llave</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Nombre</strong></td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@(item.Lugar ?? "—")</td>
                        <td>
                            @if (item.NombreCategoria != null)
                            {
                                <span class="badge bg-primary">@item.NombreCategoria</span>
                            }
                        </td>
                        <td>
                            @if (item.TieneLlave)
                            {
                                <span class="badge bg-success">Generada</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Sin llave</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay competencias. <a asp-action="Create">Agregar una</a>.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
